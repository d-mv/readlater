-- Shared pgTAP helpers, included by every test file right after `begin;`
-- with `\ir _helpers.psql`. Everything here is created inside the test's
-- transaction and rolled back with it. Not a test file itself (the runner
-- only picks up *.sql).

set local client_min_messages = warning;
create extension if not exists pgtap with schema extensions;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

-- Fixed ids so tests can refer to users/rows by literal without psql
-- variables or temp tables (which the switched-to roles couldn't read).
--   user A  = 00000000-0000-0000-0000-00000000000a
--   user B  = 00000000-0000-0000-0000-00000000000b
create function tests.create_user(p_id uuid, p_email text)
returns uuid
language sql
as $$
  insert into auth.users (id, instance_id, aud, role, email, raw_app_meta_data, raw_user_meta_data,
                          created_at, updated_at)
  values (p_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email,
          '{}'::jsonb, '{}'::jsonb, now(), now())
  returning id;
$$;

-- Act as a signed-in user for the rest of the transaction (until
-- tests.reset_role / `reset role`). Sets both claim settings auth.uid()
-- reads.
create function tests.authenticate_as(p_user uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
                     json_build_object('sub', p_user, 'role', 'authenticated')::text, true);
  perform set_config('request.jwt.claim.sub', p_user::text, true);
  perform set_config('role', 'authenticated', true);
end;
$$;

create function tests.authenticate_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('role', 'anon', true);
end;
$$;

create function tests.authenticate_service_role()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"service_role"}', true);
  perform set_config('request.jwt.claim.sub', '', true);
  perform set_config('role', 'service_role', true);
end;
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;

do $$
begin
  perform tests.create_user('00000000-0000-0000-0000-00000000000a', 'a@test.local');
  perform tests.create_user('00000000-0000-0000-0000-00000000000b', 'b@test.local');
end $$;
