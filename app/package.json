    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tabler/icons-vue": "^3.45.0",
    "dompurify": "^3.4.12",
    "idb": "^8.0.3",
    "markdown-it": "^14.3.0",
    "md-editor-v3": "^6.5.4",
    "pinia": "^4.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  }
