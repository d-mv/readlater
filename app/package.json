{
  "name": "read-later-app",
  "private": true,
  "version": "0.9.17",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc -b --noEmit && tsc -p e2e --noEmit",
    "lint": "oxlint src e2e",
    "format": "oxfmt src e2e playwright.config.ts",
    "format:check": "oxfmt --check src e2e playwright.config.ts",
    "unused-deps": "knip --dependencies"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.6",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.110.8",
    "@tabler/icons-vue": "^3.45.0",
    "@tailwindcss/vite": "^4.3.3",
    "dompurify": "^3.4.12",
    "idb": "^8.0.3",
    "markdown-it": "^14.3.0",
    "md-editor-v3": "^6.5.4",
    "pinia": "^4.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  }
}
