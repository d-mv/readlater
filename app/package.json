{
  "name": "read-later-app",
  "private": true,
  "version": "0.9.27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "vue-tsc -b --noEmit && tsc -p e2e --noEmit",
    "lint": "oxlint src e2e",
    "format": "oxfmt src e2e playwright.config.ts",
    "format:check": "oxfmt --check src e2e playwright.config.ts",
    "unused-deps": "knip --dependencies"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tabler/icons-vue": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "markdown-it": "^14.3.3",
    "md-editor-v3": "^7.1.0",
    "pinia": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  }
}
