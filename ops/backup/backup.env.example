# /etc/readlater-backup.env on the VPS — root:root, mode 600. Read by
# readlater-backup.sh through `docker run --env-file`, so values are plain
# KEY=value lines: no quotes, no `export`.

# Postgres: the Session pooler connection (IPv4) from the Supabase dashboard
# → Connect. pg_dump only reads.
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=5432
PGUSER=postgres.egkakmlkerlmsigoegoe
PGDATABASE=postgres
PGPASSWORD=<database password>
PGSSLMODE=require

# Storage: an S3 access key from the dashboard → Storage → S3 Configuration.
# It reaches Storage only, nothing else in the project or account.
AWS_ENDPOINT_URL=https://egkakmlkerlmsigoegoe.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=<access key id>
AWS_SECRET_ACCESS_KEY=<secret access key>
